// Windows resources for requestlab.exe.
//
// Only resource-language keywords and numbers are used, so rc.exe needs no
// SDK headers on its include path:
//   0x00040004 = VOS_NT_WINDOWS32, 0x00000001 = VFT_APP.

// Resource id 1 is the executable's icon: Explorer and the taskbar use it.
1 ICON "requestlab.ico"

1 VERSIONINFO
 FILEVERSION 0,1,1,0
 PRODUCTVERSION 0,1,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x00040004L
 FILETYPE 0x00000001L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RequestLab"
            VALUE "FileDescription", "RequestLab API client"
            VALUE "FileVersion", "0.1.1"
            VALUE "InternalName", "requestlab"
            VALUE "OriginalFilename", "requestlab.exe"
            VALUE "ProductName", "RequestLab"
            VALUE "ProductVersion", "0.1.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
