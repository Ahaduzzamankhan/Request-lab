#include <winres.h>

// Taskbar and Explorer icon for requestlab.exe.
IDI_REQUESTLAB ICON "requestlab.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,1,0
 PRODUCTVERSION 0,1,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RequestLab"
            VALUE "FileDescription", "RequestLab API client"
            VALUE "FileVersion", "0.1.1"
            VALUE "InternalName", "requestlab"
            VALUE "OriginalFilename", "requestlab.exe"
            VALUE "ProductName", "RequestLab"
            VALUE "ProductVersion", "0.1.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
